code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 Color : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform float Progress : hint_range(0, 1);



void fragment() {
// Input:2
	vec4 n_out2p0 = COLOR;


// ColorParameter:3
	vec4 n_out3p0 = Color;


// FloatParameter:5
	float n_out5p0 = Progress;


// Mix:4
	vec3 n_out4p0 = mix(vec3(n_out2p0.xyz), vec3(n_out3p0.xyz), vec3(n_out5p0));


// Output:0
	COLOR.rgb = n_out4p0;


}
